# --- Database (you said MySQL is already installed locally) ---
DB_USER=root
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306
DB_NAME=happyhouse

# --- Auth ---
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=
ENV=development

# --- CORS ---
FRONTEND_ORIGIN=http://localhost:3000

# --- Image storage (Cloudinary free tier is fine to start) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
