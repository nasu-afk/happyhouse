# Used by docker-compose.yml (docker compose reads .env automatically
# from the project root — this is separate from backend/.env and
# frontend/.env.local, which are only used for non-Docker local runs).

MYSQL_ROOT_PASSWORD=changeme

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=

# Optional — leave blank until you have a Cloudinary account
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
